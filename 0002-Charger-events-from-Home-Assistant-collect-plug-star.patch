@@ -0,0 +1,26 @@
+<?php
+/**
+ * Charger event endpoint — standalone file for Authentik bypass.
+ *
+ * Same reason as receive_vehicle_data.php: Home Assistant calls this directly, so
+ * the path must be excluded from the Authentik auth proxy. The handler logic
+ * lives in routes/receive_charger_event.php.
+ */
+require __DIR__ . '/includes/configuration.php';
+require __DIR__ . '/includes/DatabaseManager.php';
+require __DIR__ . '/includes/QueryBuilder.php';
+
+header('Content-Type: application/json');
+
+try {
+    require __DIR__ . '/routes/receive_charger_event.php';
+} catch (PDOException $e) {
+    http_response_code(500);
+    error_log("receive_charger_event.php DB error: " . $e->getMessage());
+    echo json_encode(['success' => false, 'error' => 'Database error occurred']);
+} catch (\Throwable $e) {
+    http_response_code(500);
+    error_log("receive_charger_event.php error: " . $e->getMessage());
+    $clientError = Config::debug() ? $e->getMessage() : 'Der opstod en intern fejl';
+    echo json_encode(['success' => false, 'error' => $clientError]);
+}
diff --git a/routes/get_charger_sessions.php b/routes/get_charger_sessions.php
new file mode 100644
index 0000000..2581691
--- /dev/null
+++ b/routes/get_charger_sessions.php
@@ -0,0 +1,37 @@
+<?php
+/**
+ * Charging sessions assembled from the charger events.
+ *
+ * GET api.php?action=charger-sessions[&days=30]   (days: 1..365)
+ *
+ * Newest first. Each session has pluggedAt / chargeStartAt / chargeEndAt /
+ * unpluggedAt, the charger's own energy and average power, and the car snapshots
+ * taken at each event. Car attribution is deliberately NOT decided here yet.
+ */
+require_once __DIR__ . '/../includes/ChargerSessions.php';
+
+$days = isset($_GET['days']) ? (int) $_GET['days'] : 30;
+$days = max(1, min(365, $days));
+$since = gmdate('Y-m-d\TH:i:s\Z', time() - $days * 86400);
+
+$db = DatabaseManager::getChargesDb();
+$stmt = $db->prepare("
+    SELECT eventAt, event, chargerStatus, sessionEnergy, lifetimeEnergy, power, cars
+    FROM charger_events WHERE eventAt >= ? ORDER BY eventAt
+");
+$stmt->execute([$since]);
+$events = $stmt->fetchAll(PDO::FETCH_ASSOC);
+foreach ($events as &$e) {
+    $e['cars'] = $e['cars'] !== null ? json_decode($e['cars'], true) : null;
+    foreach (['sessionEnergy', 'lifetimeEnergy', 'power'] as $k) {
+        if ($e[$k] !== null) $e[$k] = (float) $e[$k];
+    }
+}
+unset($e);
+
+echo json_encode([
+    'success'  => true,
+    'days'     => $days,
+    'events'   => count($events),
+    'sessions' => array_reverse(ChargerSessions::build($events)),
+]);
diff --git a/routes/receive_charger_event.php b/routes/receive_charger_event.php
new file mode 100644
index 0000000..161914a
--- /dev/null
+++ b/routes/receive_charger_event.php
@@ -0,0 +1,70 @@
+<?php
+/**
+ * Receive an event from the charger (Home Assistant).
+ *
+ * POST JSON body (see includes/ChargerEvents.php for the rules):
+ *   event           plugged | charge_start | charge_end | unplugged
+ *   eventAt         ISO 8601 timestamp of the event (HA: the entity's last_changed)
+ *   status          charger status (optional)
+ *   sessionEnergy   kWh (charge_end: the session's final energy)
+ *   lifetimeEnergy  kWh, power kW (optional)
+ *   cars            {"<vehicleId>": {soc, odometer, cable, carTs}} snapshot (optional)
+ *
+ * Idempotent: the same (event, eventAt) twice is answered 200 and stored once.
+ * Same API key as receive_vehicle_data.php (VEHICLE_API_KEY, fail closed).
+ */
+require_once __DIR__ . '/../includes/ChargerEvents.php';
+
+$apiKey = Config::vehicleApiKey();
+if ($apiKey === '') {
+    http_response_code(503);
+    echo json_encode(['success' => false, 'error' => 'Endpoint not configured — set VEHICLE_API_KEY in .env']);
+    exit;
+}
+$authHeader = $_SERVER['HTTP_AUTHORIZATION'] ?? '';
+if (!str_starts_with($authHeader, 'Bearer ') || !hash_equals($apiKey, substr($authHeader, 7))) {
+    http_response_code(401);
+    header('WWW-Authenticate: Bearer realm="SparkSpend"');
+    echo json_encode(['success' => false, 'error' => 'Unauthorized']);
+    exit;
+}
+if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
+    http_response_code(405);
+    echo json_encode(['success' => false, 'error' => 'Method not allowed']);
+    exit;
+}
+
+$raw = file_get_contents('php://input');
+$input = is_string($raw) ? json_decode($raw, true) : null;
+if (!is_array($input)) {
+    http_response_code(400);
+    echo json_encode(['success' => false, 'error' => 'Invalid JSON format']);
+    exit;
+}
+
+$v = ChargerEvents::validate($input, time());
+if (!$v['ok']) {
+    http_response_code(400);
+    echo json_encode(['success' => false, 'error' => $v['error']]);
+    exit;
+}
+$row = $v['row'];
+
+$db = DatabaseManager::getChargesDb();
+$stmt = $db->prepare("
+    INSERT OR IGNORE INTO charger_events
+        (eventAt, receivedAt, event, chargerStatus, sessionEnergy, lifetimeEnergy, power, cars)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
+");
+$stmt->execute([
+    $row['eventAt'], gmdate('Y-m-d\TH:i:s\Z'), $row['event'], $row['chargerStatus'],
+    $row['sessionEnergy'], $row['lifetimeEnergy'], $row['power'], $row['cars'],
+]);
+
+if ($stmt->rowCount() > 0) {
+    http_response_code(201);
+    echo json_encode(['success' => true, 'message' => 'Event stored']);
+} else {
+    http_response_code(200);
+    echo json_encode(['success' => true, 'message' => 'Duplicate ignored']);
+}
-- 

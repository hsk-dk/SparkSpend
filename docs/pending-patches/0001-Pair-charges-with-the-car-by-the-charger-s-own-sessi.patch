+<?php
+/**
+ * charges.vehicleId was stored as a BLOB ('2' as bytes) on two legacy rows, so
+ * "WHERE vehicleId = 2" never matched them and their 57.8 kWh went missing from
+ * every per-car figure. Cast them to INTEGER.
+ */
+return [
+    'description' => 'Cast BLOB charges.vehicleId values to INTEGER',
+    'up' => [
+        "UPDATE charges SET vehicleId = CAST(CAST(vehicleId AS TEXT) AS INTEGER) WHERE typeof(vehicleId) = 'blob'",
+    ],
+];

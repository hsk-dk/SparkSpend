@@ -50,9 +50,9 @@ $r = $m([['vehicleId' => ENYAQ, 'ts' => $T + 4000]]);
 check('only a later reading -> unknown', [$r['vehicleId'], $r['source']], [null, 'unknown']);
 
 echo "rank()\n";
-check('order manual>api>matched>uncertain>default=legacy>unknown',
-    array_map([VehiclePairing::class, 'rank'], ['manual', 'api', 'matched', 'uncertain', 'default', 'legacy', 'unknown', null]),
-    [5, 4, 3, 2, 1, 1, 0, 0]);
+check('order manual>api>charger>matched>uncertain>default=legacy>unknown',
+    array_map([VehiclePairing::class, 'rank'], ['manual', 'api', 'charger', 'matched', 'uncertain', 'default', 'legacy', 'unknown', null]),

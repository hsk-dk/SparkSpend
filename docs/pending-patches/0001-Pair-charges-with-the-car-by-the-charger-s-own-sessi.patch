diff --git a/dev/test_charger_pairing.php b/dev/test_charger_pairing.php
new file mode 100644
index 0000000..13b46cb
--- /dev/null
+++ b/dev/test_charger_pairing.php
@@ -0,0 +1,127 @@
+<?php
+/**
+ * Tests for ChargerPairing (decision rules) and ChargerReconciler (database step).
+ * Run:  php dev/test_charger_pairing.php
+ *
+ * dev/fixtures/charger_pairing_real.json is real data (1-2 Nov 2026): two sessions
+ * where the plug-in time-match picked the wrong car both times.
+ */
+require __DIR__ . '/../includes/MigrationRunner.php';
+require __DIR__ . '/../includes/ChargerReconciler.php';
+
+$fails = 0; $n = 0;
+function check(string $name, $actual, $expected): void {
+    global $fails, $n; $n++;
+    if ($actual === $expected) { echo "  ok   $name\n"; return; }
+    $fails++;
+    echo "  FAIL $name\n       expected " . json_encode($expected) . "\n       got      " . json_encode($actual) . "\n";
+}
+
+$UP = 3; $ENYAQ = 2;
+// limits as learned from real labelled charges
+$profiles = [
+    $UP    => ['n' => 17, 'kw' => 7.2,  'kwh' => 26.5],
+    $ENYAQ => ['n' => 40, 'kw' => 10.7, 'kwh' => 55.0],
+];
+$sess = fn(array $start, array $end, ?float $kw = null, ?float $kwh = null) => [
+    'avgPowerKw' => $kw, 'energyKwh' => $kwh,
+    'cars' => ['plugged' => null, 'charge_start' => $start, 'charge_end' => $end, 'unplugged' => null],
+];
+$car = fn($soc, $cable = null) => ['soc' => $soc, 'cable' => $cable];
+$dec = fn($s, $p = null) => array_values(array_intersect_key(ChargerPairing::decide($s, $p ?? $profiles, [2, 3]), ['vehicleId' => 1, 'source' => 1]));
+
+echo "profiles()\n";
+$lab = []; foreach ([20, 22, 24, 25, 26, 27] as $k) $lab[] = ['vehicleId' => 3, 'kwh' => $k, 'kw' => 6.0];
+$lab[] = ['vehicleId' => 2, 'kwh' => 30, 'kw' => 10.5];
+$p = ChargerPairing::profiles($lab);
+check('car with < 5 charges gets no limits', array_keys($p), [3]);
+check('p95 of kWh is between the two largest', $p[3]['kwh'] > 26 && $p[3]['kwh'] <= 27, true);
+check('p95 of kW', $p[3]['kw'], 6.0);
+check('charges under 1 kWh ignored', count(ChargerPairing::profiles(array_fill(0, 9, ['vehicleId' => 3, 'kwh' => 0.4, 'kw' => 3]))), 0);
+
+echo "decide() — SoC rise\n";
+check('sole big riser -> charger', $dec($sess([2 => $car(28), 3 => $car(40)], [2 => $car(28), 3 => $car(100)], 6.1, 21.2)), [3, 'charger']);
+check('stale other car dropping does not matter', $dec($sess([2 => $car(28), 3 => $car(100)], [2 => $car(79), 3 => $car(89)], 10.6, 40.9)), [2, 'charger']);
+check('rise 5..9 alone -> uncertain', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(57), 3 => $car(50)], 10.5, 8.0)), [2, 'uncertain']);
+check('rise 5..9 + only that cable connected -> charger', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(57, 'on'), 3 => $car(50, 'disconnected')], 10.5, 8.0)), [2, 'charger']);
+check('both cars rise -> not decided by SoC', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(70), 3 => $car(70)])), [null, 'unknown']);
+check('other car rising 4 points is unclear', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(80), 3 => $car(54)])), [null, 'unknown']);
+check('missing SoC data -> unknown', $dec($sess([2 => $car(50)], [2 => $car(80)])), [2, 'charger']);   // car 3 absent: car 2 is the sole riser
+check('no snapshots at all -> unknown', ChargerPairing::decide(['cars' => []], $profiles)['source'], 'unknown');
+check('one car known -> unknown', ChargerPairing::decide($sess([2 => $car(10)], [2 => $car(90)]), $profiles, [2])['source'], 'unknown');
+
+echo "decide() — power / energy limits\n";
+check('SoC says e-Up but 10.6 kW is impossible -> unknown (conflict)', $dec($sess([2 => $car(28), 3 => $car(40)], [2 => $car(28), 3 => $car(80)], 10.6, 30.0)), [null, 'unknown']);
+check('no SoC change, 10.6 kW rules out e-Up -> Enyaq', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50), 3 => $car(50)], 10.6, 20.0)), [2, 'charger']);
+check('no SoC change, 31 kWh rules out e-Up -> Enyaq', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50), 3 => $car(50)], 6.0, 40.0)), [2, 'charger']);
+check('slow power rules nobody out', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50), 3 => $car(50)], 3.0, 10.0)), [null, 'unknown']);
+check('without limits no veto', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50), 3 => $car(50)], 10.6, 40.0), []), [null, 'unknown']);
+
+echo "decide() — cable\n";
+check('only one cable connected -> uncertain', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50, 'off'), 3 => $car(50, 'connected')], 3.0, 10.0)), [3, 'uncertain']);
+check('both cables connected -> unknown', $dec($sess([2 => $car(50), 3 => $car(50)], [2 => $car(50, 'on'), 3 => $car(50, 'connected')], 3.0, 10.0)), [null, 'unknown']);
+
+echo "real sessions (1-2 Nov 2026)\n";
+$fx = json_decode(file_get_contents(__DIR__ . '/fixtures/charger_pairing_real.json'), true);
+$sessions = ChargerSessions::build($fx['events']);
+check('two sessions assembled', count($sessions), 2);
+$truth = [$UP, $ENYAQ];
+foreach ($sessions as $i => $s) {
+    $d = ChargerPairing::decide($s, $profiles, [2, 3]);
+    check("session " . ($i + 1) . " -> car {$truth[$i]}", [$d['vehicleId'], $d['source']], [$truth[$i], 'charger']);
+}
+
+echo "ChargerReconciler::run()\n";
+function freshDb(array $fx): PDO {
+    $db = new PDO('sqlite::memory:'); $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+    MigrationRunner::run($db, __DIR__ . '/../migrations/charges');
+    $db->exec("INSERT INTO vehicles (id, vehicleName) VALUES (1,'Ukendt'),(2,'Enyaq'),(3,'e-Up')");
+    $ins = $db->prepare("INSERT INTO charges (id, startedAt, stoppedAt, consumedKwh, vehicleId, pairingSource) VALUES (?,?,?,?,?,?)");
+    $wrong = ['904760793841055643' => 2, '905028159648177382' => 3];     // what the plug-in match said
+    foreach ($fx['charges'] as $c) $ins->execute([$c['id'], $c['startedAt'], $c['stoppedAt'], $c['consumedKwh'], $wrong[$c['id']], 'matched']);
+    $ev = $db->prepare("INSERT INTO charger_events (eventAt, receivedAt, event, chargerStatus, sessionEnergy, lifetimeEnergy, power, cars) VALUES (?,?,?,?,?,?,?,?)");
+    foreach ($fx['events'] as $e) $ev->execute([$e['eventAt'], $e['eventAt'], $e['event'], $e['chargerStatus'], $e['sessionEnergy'], $e['lifetimeEnergy'], $e['power'], json_encode($e['cars'])]);
+    return $db;
+}
+$NOW = strtotime('2026-11-04T16:00:00Z');
+$state = fn(PDO $db) => array_map(fn($r) => [(string) $r[0], (int) $r[1], $r[2]],
+    $db->query("SELECT id, vehicleId, pairingSource FROM charges ORDER BY startedAt")->fetchAll(PDO::FETCH_NUM));
+
+$db = freshDb($fx);
+$rows = ChargerReconciler::run($db, true, $NOW);
+check('dry run reports 2 updates', array_column($rows, 'action'), ['updated', 'updated']);
+check('dry run changes nothing', array_column($state($db), 1), [2, 3]);
+
+$rows = ChargerReconciler::run($db, false, $NOW);
+check('wrong pairings corrected', $state($db), [['904760793841055643', 3, 'charger'], ['905028159648177382', 2, 'charger']]);
+check('second run is idempotent', array_column(ChargerReconciler::run($db, false, $NOW), 'action'), ['confirmed', 'confirmed']);
+
+$db = freshDb($fx);
+$db->exec("UPDATE charges SET vehicleId = 2, pairingSource = 'manual' WHERE id = '904760793841055643'");    // user disagrees with the charger
+$rows = ChargerReconciler::run($db, false, $NOW);
+check('manual correction is never overwritten', [$rows[0]['action'], $state($db)[0][1], $state($db)[0][2]], ['kept', 2, 'manual']);
+$db->exec("UPDATE charges SET vehicleId = 3, pairingSource = 'manual' WHERE id = '904760793841055643'");
+check('manual that agrees is confirmed', ChargerReconciler::run($db, false, $NOW)[0]['action'], 'confirmed');
+
+$db = freshDb($fx);
+$db->exec("UPDATE charges SET consumedKwh = 30 WHERE id = '904760793841055643'");
+check('energy mismatch -> no pairing', ChargerReconciler::run($db, false, $NOW)[0]['action'], 'no_charge');
+$db = freshDb($fx);
+$db->exec("UPDATE charges SET startedAt = '2026-11-02T03:00:00Z' WHERE id = '904760793841055643'");
+check('time mismatch -> no pairing', ChargerReconciler::run($db, false, $NOW)[0]['action'], 'no_charge');
+$db = freshDb($fx);
+check('events older than the window are ignored', ChargerReconciler::run($db, false, strtotime('2027-03-01T00:00:00Z')), []);
+$db = new PDO('sqlite::memory:');
+check('no charger_events table -> nothing to do', ChargerReconciler::run($db), []);
+
+echo "migration 006\n";
+$db = new PDO('sqlite::memory:'); $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+$db->exec("CREATE TABLE charges (id TEXT PRIMARY KEY, vehicleId INTEGER)");
+$db->exec("INSERT INTO charges VALUES ('a', X'32'), ('b', 3)");
+check('setup: one BLOB', $db->query("SELECT COUNT(*) FROM charges WHERE typeof(vehicleId)='blob'")->fetchColumn(), 1);
+foreach ((require __DIR__ . '/../migrations/charges/006_fix_blob_vehicle_ids.php')['up'] as $sql) $db->exec($sql);
+check('BLOB became INTEGER 2', $db->query("SELECT vehicleId, typeof(vehicleId) FROM charges WHERE id='a'")->fetch(PDO::FETCH_NUM), [2, 'integer']);
+check('other rows untouched', $db->query("SELECT vehicleId FROM charges WHERE id='b'")->fetchColumn(), 3);
+
+echo "\n$n checks, $fails failed\n";
+exit($fails ? 1 : 0);
diff --git a/dev/test_vehicle_pairing.php b/dev/test_vehicle_pairing.php
index 50fbd7b..72acc53 100644

diff --git a/includes/ChargerPairing.php b/includes/ChargerPairing.php
new file mode 100644
index 0000000..b5c6e90
--- /dev/null
+++ b/includes/ChargerPairing.php
@@ -0,0 +1,148 @@
+<?php
+/**
+ * Which car charged? Decided from what the CHARGER and the cars reported during one
+ * charging session (pure functions, unit-tested: php dev/test_charger_pairing.php).
+ *
+ * Why this exists: the plug-in time-match (VehiclePairing::match) only knows which
+ * car was plugged in LAST. Real data showed that is often wrong - the cars' cloud
+ * data arrives hours late and the cable sensors are unreliable. What is reliable:
+ *
+ *   - the battery level of the car that charged RISES between charge_start and
+ *     charge_end (other cars stay put or drop)
+ *   - each car has a power signature: the Enyaq pulls ~10.5 kW, the e-Up never more
+ *     than ~7.5 kW (AC) and never takes more than ~27 kWh
+ *
+ * Decision rules, in order (first that applies wins):
+ *   1. Exactly one car's SoC rose >= SOC_RISE_MIN while all others rose <= SOC_OTHER_MAX
+ *      -> that car. 'charger' when the rise is >= SOC_RISE_SURE (or only that car's cable
+ *      reads connected), otherwise 'uncertain'. If power/energy rule that car out, the
+ *      evidence contradicts itself -> unknown (a human decides).
+ *   2. Power/energy rule out all but one car -> that car ('charger', evidence 'veto').
+ *   3. Exactly one car's cable reads connected at the end -> that car ('uncertain').
+ *   4. Otherwise unknown.
+ */
+final class ChargerPairing {
+
+    public const SOC_RISE_SURE = 10;    // points
+    public const SOC_RISE_MIN  = 5;
+    public const SOC_OTHER_MAX = 3;
+    public const MIN_SAMPLES   = 5;     // charges needed before a car's power/energy limits are trusted
+    private const KW_MARGIN    = 1.15;
+    private const KWH_MARGIN   = 1.30;
+
+    /**
+     * Power/energy limits per car from charges whose car is known.
+     *
+     * @param array<int,array{vehicleId:int,kwh:float,kw:?float}> $labelled
+     * @return array<int,array{n:int,kw:?float,kwh:?float}>  limits (p95) per vehicleId; only cars with enough samples
+     */
+    public static function profiles(array $labelled): array {
+        $kw = $kwh = [];
+        foreach ($labelled as $c) {
+            $v = (int) $c['vehicleId'];
+            if ($v <= 0 || !isset($c['kwh']) || $c['kwh'] < 1.0) continue;
+            $kwh[$v][] = (float) $c['kwh'];
+            if (isset($c['kw']) && $c['kw'] > 0) $kw[$v][] = (float) $c['kw'];
+        }
+        $out = [];
+        foreach ($kwh as $v => $list) {
+            if (count($list) < self::MIN_SAMPLES) continue;
+            $out[$v] = [
+                'n'   => count($list),
+                'kw'  => isset($kw[$v]) && count($kw[$v]) >= self::MIN_SAMPLES ? self::p95($kw[$v]) : null,
+                'kwh' => self::p95($list),
+            ];
+        }
+        return $out;
+    }
+
+    /**
+     * @param array $session   one entry from ChargerSessions::build() (needs 'cars', 'energyKwh', 'avgPowerKw')
+     * @param array $profiles  result of profiles()
+     * @param int[] $candidates vehicleIds that can have charged (empty = every car seen in the session)
+     * @return array{vehicleId:?int,source:string,evidence:string}
+     */
+    public static function decide(array $session, array $profiles, array $candidates = []): array {
+        $cars  = $session['cars'] ?? [];
+        $start = $cars['charge_start'] ?? $cars['plugged'] ?? null;
+        $end   = $cars['charge_end'] ?? null;
+
+        if (!$candidates) {
+            foreach ($cars as $snap) {
+                if (is_array($snap)) foreach (array_keys($snap) as $k) $candidates[] = (int) $k;
+            }
+        }
+        $candidates = array_values(array_unique(array_filter(array_map('intval', $candidates), fn($v) => $v > 0)));
+        if (!$candidates) return self::unknown('no cars in the charger snapshots');
+        if (count($candidates) === 1) return self::unknown('only one car known - nothing to tell apart');
+
+        // Power / energy limits
+        $kw  = $session['avgPowerKw'] ?? null;
+        $kwh = $session['energyKwh']  ?? null;
+        $vetoed = [];
+        foreach ($candidates as $v) {
+            $p = $profiles[$v] ?? null;
+            if (!$p) continue;
+            if ($kw  !== null && $p['kw']  !== null && $kw  > $p['kw']  * self::KW_MARGIN)  $vetoed[$v] = sprintf('%.1f kW > %s max %.1f kW', $kw, "car $v", $p['kw']);
+            if ($kwh !== null && $p['kwh'] !== null && $kwh > $p['kwh'] * self::KWH_MARGIN) $vetoed[$v] = sprintf('%.1f kWh > car %d max %.1f kWh', $kwh, $v, $p['kwh']);
+        }
+
+        // 1. SoC rise
+        $risers = [];
+        $others = true;
+        $rises  = [];
+        foreach ($candidates as $v) {
+            $a = $start[$v]['soc'] ?? null;
+            $b = $end[$v]['soc']   ?? null;
+            $rise = (is_numeric($a) && is_numeric($b)) ? (float) $b - (float) $a : null;
+            $rises[$v] = $rise;
+            if ($rise !== null && $rise >= self::SOC_RISE_MIN) $risers[] = $v;
+            elseif ($rise !== null && $rise > self::SOC_OTHER_MAX) $others = false;   // 3 < rise < 5: neither clearly rising nor still
+        }
+        if (count($risers) === 1 && $others) {
+            $v = $risers[0];
+            $ev = sprintf('SoC +%d points (car %d)', $rises[$v], $v);
+            if (isset($vetoed[$v])) return self::unknown("$ev, but " . $vetoed[$v]);
+            $sure = $rises[$v] >= self::SOC_RISE_SURE || self::onlyCableConnected($end, $candidates) === $v;
+            return ['vehicleId' => $v, 'source' => $sure ? 'charger' : 'uncertain', 'evidence' => $ev];
+        }
+
+        // 2. Power / energy rule out all but one
+        if ($vetoed) {
+            $left = array_values(array_diff($candidates, array_keys($vetoed)));
+            if (count($left) === 1) {
+                return ['vehicleId' => $left[0], 'source' => 'charger',
+                        'evidence' => 'veto: ' . implode('; ', $vetoed)];
+            }
+        }
+
+        // 3. Cable
+        $only = self::onlyCableConnected($end, array_values(array_diff($candidates, array_keys($vetoed))));
+        if ($only !== null) {
+            return ['vehicleId' => $only, 'source' => 'uncertain', 'evidence' => "only car $only's cable reads connected"];
+        }
+        return self::unknown('no clear SoC rise, power or cable evidence');
+    }
+
+    /** vehicleId of the single car whose cable sensor reads "connected" in $snap, else null. */
+    private static function onlyCableConnected(?array $snap, array $among): ?int {
+        if (!$snap) return null;
+        $on = [];
+        foreach ($among as $v) {
+            $c = strtolower((string) ($snap[$v]['cable'] ?? ''));
+            if (in_array($c, ['connected', 'on', 'true', 'plugged', 'locked'], true)) $on[] = $v;
+        }
+        return count($on) === 1 ? $on[0] : null;
+    }
+
+    private static function unknown(string $why): array {
+        return ['vehicleId' => null, 'source' => 'unknown', 'evidence' => $why];
+    }
+
+    private static function p95(array $v): float {
+        sort($v);
+        $i = (count($v) - 1) * 0.95;
+        $lo = (int) floor($i); $hi = (int) ceil($i);
+        return $v[$lo] + ($v[$hi] - $v[$lo]) * ($i - $lo);
+    }
+}
diff --git a/includes/ChargerReconciler.php b/includes/ChargerReconciler.php
new file mode 100644
index 0000000..4a7b1c1
--- /dev/null
+++ b/includes/ChargerReconciler.php
@@ -0,0 +1,104 @@
+<?php
+/**
+ * Connects Monta charges to charging sessions seen by the charger (Home Assistant)
+ * and lets ChargerPairing decide which car charged.
+ *
+ * Runs after every Monta sync (cron/update_monta_data.php) and when a session ends
+ * (routes/receive_charger_event.php) - whichever data arrives last completes the pair.
+ * Pairings only move UP in confidence (VehiclePairing::resolve): a manual correction
+ * is never touched, and a weaker verdict never overwrites a stronger one.
+ */
+require_once __DIR__ . '/VehiclePairing.php';
+require_once __DIR__ . '/ChargerSessions.php';
+require_once __DIR__ . '/ChargerPairing.php';
+
+final class ChargerReconciler {
+
+    private const MATCH_TOLERANCE_SEC = 1200;   // Monta vs charger clock/latency
+    private const MATCH_TOLERANCE_KWH = 0.05;   // 5 %
+    private const MIN_KWH             = 1.0;
+    private const LEARN_SOURCES       = ['manual', 'matched', 'charger', 'api'];
+
+    /**
+     * @return array<int,array> one row per charger session that was looked at:
+     *         chargeId, action (updated|confirmed|kept|no_charge|no_decision), from, to, decision, session
+     */
+    public static function run(PDO $db, bool $dryRun = false, ?int $now = null, int $days = 90): array {
+        $now ??= time();
+        $has = $db->query("SELECT 1 FROM sqlite_master WHERE type='table' AND name='charger_events'")->fetchColumn();
+        if (!$has) return [];
+
+        $since = gmdate('Y-m-d\TH:i:s\Z', $now - $days * 86400);
+        $stmt  = $db->prepare("SELECT eventAt, event, sessionEnergy, lifetimeEnergy, power, chargerStatus, cars
+                               FROM charger_events WHERE eventAt >= ? ORDER BY eventAt");
+        $stmt->execute([$since]);
+        $events = [];
+        foreach ($stmt->fetchAll(PDO::FETCH_ASSOC) as $r) {
+            $r['cars'] = $r['cars'] ? json_decode($r['cars'], true) : null;
+            $events[] = $r;
+        }
+        $sessions = array_values(array_filter(
+            ChargerSessions::build($events),
+            fn($s) => $s['chargeStartAt'] && $s['chargeEndAt'] && ($s['energyKwh'] ?? 0) >= self::MIN_KWH
+        ));
+        if (!$sessions) return [];
+
+        $charges = $db->query("SELECT id, vehicleId, pairingSource, startedAt, stoppedAt, consumedKwh
+                               FROM charges WHERE consumedKwh >= " . self::MIN_KWH)->fetchAll(PDO::FETCH_ASSOC);
+
+        // 1. pair sessions with charges (one-to-one, closest start wins)
+        $pairs = []; $used = [];
+        foreach ($sessions as $si => $s) {
+            $best = null; $bestDiff = PHP_INT_MAX;
+            $cs = strtotime($s['chargeStartAt']); $ce = strtotime($s['chargeEndAt']);
+            foreach ($charges as $c) {
+                if (isset($used[$c['id']]) || !$c['startedAt'] || !$c['stoppedAt']) continue;
+                $d1 = abs(strtotime((string) $c['startedAt']) - $cs);
+                $d2 = abs(strtotime((string) $c['stoppedAt']) - $ce);
+                if ($d1 > self::MATCH_TOLERANCE_SEC || $d2 > self::MATCH_TOLERANCE_SEC) continue;
+                if (abs((float) $c['consumedKwh'] - $s['energyKwh']) > self::MATCH_TOLERANCE_KWH * max($s['energyKwh'], (float) $c['consumedKwh'])) continue;
+                if ($d1 < $bestDiff) { $best = $c; $bestDiff = $d1; }
+            }
+            if ($best) { $pairs[$si] = $best; $used[$best['id']] = true; }
+        }
+
+        // 2. power/energy profiles from charges with a known car - not the ones being decided now
+        $labelled = [];
+        foreach ($charges as $c) {
+            $v = (int) $c['vehicleId'];
+            if ($v <= 0 || isset($used[$c['id']]) || !in_array($c['pairingSource'], self::LEARN_SOURCES, true)) continue;
+            $h = (strtotime((string) $c['stoppedAt']) - strtotime((string) $c['startedAt'])) / 3600;
+            $labelled[] = ['vehicleId' => $v, 'kwh' => (float) $c['consumedKwh'], 'kw' => $h > 0 ? (float) $c['consumedKwh'] / $h : null];
+        }
+        $profiles = ChargerPairing::profiles($labelled);
+
+        // 3. decide
+        $known = array_map('intval', $db->query("SELECT id FROM vehicles WHERE id > 1")->fetchAll(PDO::FETCH_COLUMN));
+        $upd = $dryRun ? null : $db->prepare("UPDATE charges SET vehicleId = ?, pairingSource = ? WHERE id = ?");
+        $rows = [];
+        foreach ($sessions as $si => $s) {
+            $row = ['chargeId' => null, 'action' => 'no_charge', 'from' => null, 'to' => null, 'decision' => null,
+                    'session' => ['start' => $s['chargeStartAt'], 'end' => $s['chargeEndAt'], 'kWh' => $s['energyKwh'], 'kW' => $s['avgPowerKw']]];
+            if (!isset($pairs[$si])) { $rows[] = $row; continue; }
+            $c = $pairs[$si];
+            $row['chargeId'] = $c['id'];
+            $row['from'] = ['vehicleId' => (int) $c['vehicleId'], 'source' => $c['pairingSource']];
+
+            $d = ChargerPairing::decide($s, $profiles, $known);
+            $row['decision'] = $d;
+            if ($d['vehicleId'] === null) { $row['action'] = 'no_decision'; $row['to'] = $row['from']; $rows[] = $row; continue; }
+
+            $new = VehiclePairing::resolve((int) $c['vehicleId'], $c['pairingSource'], $d['vehicleId'], $d['source']);
+            $row['to'] = $new;
+            $changed = $new['vehicleId'] !== (int) $c['vehicleId'] || $new['source'] !== $c['pairingSource'];
+            if ($changed) {
+                $row['action'] = 'updated';
+                if ($upd) $upd->execute([$new['vehicleId'], $new['source'], $c['id']]);
+            } else {
+                $row['action'] = ((int) $c['vehicleId'] === $d['vehicleId']) ? 'confirmed' : 'kept';
+            }
+            $rows[] = $row;
+        }
+        return $rows;
+    }
+}

+                $r['from']['vehicleId'], $r['from']['source'], $r['to']['vehicleId'], $r['to']['source'], $r['decision']['evidence']));
+        }
+    }
+} catch (\Throwable $e) {
+    logMsg('Charger pairing failed: ' . $e->getMessage());
+}
+
+if ($count > 0 || $chargerUpdates > 0) {
     QueryBuilder::invalidateChargeCaches();
 }
 

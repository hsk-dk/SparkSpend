# SparkSpend Environment Configuration
# Copy this file to .env and fill in your actual values
# .env file should NOT be committed to git

# Monta API Credentials
# Get these from your Monta account
MONTA_CLIENT_ID=
MONTA_CLIENT_SECRET=

# Database Paths
# Use absolute paths for proper FPM compatibility
# Example: /var/www/monta/data/charging_data.db
CHARGING_DB_PATH=/path/to/your/installation/data/charging_data.db
POWERLOG_DB_PATH=/path/to/your/installation/data/powerlog_data.db

# MySQL / MariaDB — Heat pump sync source and house power meter
MYSQL_HEATPUMP_HOST=localhost
MYSQL_HEATPUMP_PORT=3306
MYSQL_HEATPUMP_USER=
MYSQL_HEATPUMP_PASSWORD=
MYSQL_HEATPUMP_DATABASE=
MYSQL_HEATPUMP_TABLE=powerlog
MYSQL_HOUSEPOWERLOG_TABLE=powerloghus
HEATPUMP_SYNC_INTERVAL=300

# Electricity cost — spot price area and grid operator GLN
# Area: DK1 (Jutland/Funen) or DK2 (Zealand/islands)
# GLN:  your grid operator's EAN/GLN number (digits only)
#       Radius Elnet:           5790000705689
#       Cerius (SEAS-NVE):      5790000705184
#       N1:                     5790001089030
#       SE Net:                 5790000705870
#       FLOW Elnet (Trefor):    5790000392551
#       NKE-Elnet:              5790000610764
#       Nord Energi Net:        5790001088583
#       Konstant Net:           5790000706006
#       RAH Net:                5790000610822
#       Dinel:                  5790000610099
#       Elektrus:               5790000836239
ELSPOT_AREA=DK2
ELSPOT_GLN=

# Weather data — WGS84 coordinates for degree-day (HDD 17°C) calculation via Open-Meteo
# Used for heat pump efficiency analysis (kWh/GD) and expected-vs-actual comparison
WEATHER_LAT=
WEATHER_LON=

# Timezone for date/time operations
TIMEZONE=Europe/Copenhagen

# Debug Mode (true|false)
# Set to false in production
DEBUG=false

# Auto-run DB migrations on web requests (true|false)
# Default true. Set to false in production to run migrations only via the
# explicit deploy step: `php migrate.php`
AUTO_MIGRATE=true

# Fixed electricity subscription in kr per day. Added as its own line to the
# monthly estimate ("Forventet elregning"). Leave at 0 if not applicable.
SUBSCRIPTION_PER_DAY=0

# Error Logging Path
LOG_PATH=/var/log/php_errors.log
# cron/cron.log is rotated by the jobs themselves when it passes this size (bytes), keeping LOG_KEEP old files
# LOG_MAX_BYTES=5242880
# LOG_KEEP=3

# Energi Data Service (elpriser) rate-limiter hårdt. Sæt til false, når cron/warm_prices.php
# kører i cron: så læser web-requests kun cachen og konkurrerer ikke med opvarmningen om kvoten.
# Standard true (web-requests må selv hente priser).
EDS_WEB_FETCH=true

# Ladeoptimering (Elbil > Analyse): hvor mange timer efter tilslutning bilen regnes for at være
# tilgængelig til at flytte opladningen (EV_FLEX_HOURS), og laderens effekt i kW (EV_MAX_KW).
EV_FLEX_HOURS=12
EV_MAX_KW=7.4

# Afgiftssatser (elafgift, moms) ligger i config/tax_rates.json. Disse overstyrer kun filen:
# VAT_FACTOR=1.25
# ELVARME_HIGH_KWH_YEAR=4000
# TAX_RATES_FILE=

# Nøgler til de maskin-endpoints, der ligger uden om Authentik (lange tilfældige værdier, f.eks. openssl rand -hex 24):
# VEHICLE_API_KEY  = Home Assistant -> receive_vehicle_data / receive_charger_event / receive_device_energy
# HEALTH_KEY       = Uptime Kuma -> health.php (skrivebeskyttet datafriskhed). Brug en anden værdi end VEHICLE_API_KEY.
VEHICLE_API_KEY=
HEALTH_KEY=

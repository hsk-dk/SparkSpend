# SparkSpend Environment Configuration
# Copy this file to .env and fill in your actual values
# .env file should NOT be committed to git

# Monta API Credentials
# Get these from your Monta account
MONTA_CLIENT_ID=
MONTA_CLIENT_SECRET=

# Database Paths
# Use absolute paths for proper FPM compatibility
# Example: /var/www/monta/data/charging_data.db
CHARGING_DB_PATH=/path/to/your/installation/data/charging_data.db
POWERLOG_DB_PATH=/path/to/your/installation/data/powerlog_data.db

# Timezone for date/time operations
TIMEZONE=Europe/Copenhagen

# Debug Mode (true|false)
# Set to false in production
DEBUG=false

# Error Logging Path
LOG_PATH=/var/log/php_errors.log

+    if ($eq) foreach ($new as $k => $p) foreach (['timestamp', 'totalKmPerKwh', 'totalKrPerKm'] as $f) if (abs($p[$f] - $old[$k][$f]) > 1e-9) $eq = false;
+    $eq ? $same++ : $bad++;
+}

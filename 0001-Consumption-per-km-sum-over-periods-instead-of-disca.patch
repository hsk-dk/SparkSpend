+check('no point until there is both km and energy', count($c), 1);
+check('cumulative values', [$c[0]['totalKm'], $c[0]['totalKwh'], $c[0]['totalKmPerKwh'], $c[0]['totalKrPerKm'], $c[0]['timestamp']], [100.0, 20.0, 5.0, 0.4, 20]);

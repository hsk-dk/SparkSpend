+            $rk += $km; $rw += $kwh; $rp += $pris;
+            $out[] = ['timestamp' => $readings[$i]['ts'], 'totalKm' => $rk, 'totalKwh' => $rw, 'totalKmPerKwh' => round($rk / $rw, 2), 'totalKrPerKm' => round($rp / $rk, 2)];

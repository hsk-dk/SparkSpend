 includes/Projection.php          |  98 ++++++++++++++++++++++++++++++
 includes/dashboard.js            |  16 ++++-
 routes/get_dashboard_summary.php | 101 ++++++-------------------------
 4 files changed, 218 insertions(+), 83 deletions(-)
 create mode 100644 dev/test_projection.php
